# DbGate connections for docker run --env-file
CONNECTIONS=pg,mssql,lite,mongo,nohost
export LABEL_pg="Orders PG"
SERVER_pg=pg1.acme.internal
PORT_pg=5433
USER_pg=orders_ro
PASSWORD_pg=secret
DATABASE_pg=orders
ENGINE_pg=postgres@dbgate-plugin-postgres
READONLY_pg=1
USE_SSL_pg=1
SSL_REJECT_UNAUTHORIZED_pg=true
SSL_CA_FILE_pg=/etc/ssl/acme-ca.pem
USE_SSH_pg=1
SSH_HOST_pg=bastion.acme.internal
SSH_PORT_pg=2222
SSH_LOGIN_pg=jump
SSH_MODE_pg=keyFile
SSH_KEY_FILE_pg=/home/me/.ssh/id_ed25519

LABEL_mssql='Ops SQL'
SERVER_mssql=sql01.acme.internal
ENGINE_mssql=mssql@dbgate-plugin-mssql
AUTH_TYPE_mssql=sspi
SSL_TRUST_CERTIFICATE_mssql=1

LABEL_lite=Local file
FILE_lite=/data/app.sqlite
ENGINE_lite=sqlite@dbgate-plugin-sqlite

LABEL_mongo=Mongo
URL_mongo=mongodb://localhost:27017
ENGINE_mongo=mongo@dbgate-plugin-mongo

LABEL_nohost=Missing host
ENGINE_nohost=mysql@dbgate-plugin-mysql
